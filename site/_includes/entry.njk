---
layout: base.njk
---
<article class="entry">
  <p class="meta">
    <time datetime="{{ page.date | isoDate }}">{{ page.date | isoDate }}</time>
    · <span class="tag tag-{{ author }}">{{ author }}</span>
    {% if type %}· <span class="tag">{{ type }}</span>{% endif %}
    {% if gate %}· <span class="tag tag-gate">gate {{ gate }}</span>{% endif %}
  </p>
  <h1>{{ title }}</h1>
  {% if summary %}<p class="lede">{{ summary }}</p>{% endif %}
  {{ content | safe }}
  <p class="back"><a href="{{ '/journal/' | url }}">← All journal entries</a></p>
</article>
